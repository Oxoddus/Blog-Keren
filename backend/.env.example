# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/teknofixhub
DB_NAME=teknofixhub

# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRE=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=../media

# API
API_VERSION=v1
API_URL=http://localhost:5000

# Notifications
WHATSAPP_API_URL=https://api.whatsapp.com/send
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Payment
PAYMENT_PROVIDER=qris
PAYMENT_MERCHANT_ID=your_merchant_id
COD_ENABLED=true

# Shipping / Delivery
SHIPPING_PROVIDER=jne
SHIPPING_API_KEY=your_shipping_api_key

# Mobile access
MOBILE_SUPPORT=true

# Social profiles
SOCIAL_INSTAGRAM=https://instagram.com/teknofixhub
SOCIAL_FACEBOOK=https://facebook.com/teknofixhub
SOCIAL_LINKEDIN=https://linkedin.com/company/teknofixhub
SOCIAL_TWITTER=https://twitter.com/teknofixhub
